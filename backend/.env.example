# Bu faylni .env nomiga nusxalab, haqiqiy qiymatlarni kiriting.
# .env fayli HECH QACHON GitHub'ga push qilinmaydi (.gitignore'da).

# --- Ma'lumotlar bazasi ---
# MUHIM (1-Qavat, RLS uchun): bu yerdagi foydalanuvchi HECH QACHON Postgres
# superuser (masalan `postgres`) bo'lmasligi kerak — superuser va
# `BYPASSRLS` huquqiga ega rol Row-Level Security siyosatlarini AVTOMATIK
# chetlab o'tadi, ya'ni RLS "ishlayotgandek ko'rinib", aslida hech narsani
# himoya qilmaydi. Shu sababli alohida, cheklangan huquqli rol yarating:
#
#   CREATE ROLE personal_os_app LOGIN PASSWORD '<parol>' NOSUPERUSER NOBYPASSRLS;
#   GRANT ALL ON SCHEMA public TO personal_os_app;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON TABLES TO personal_os_app;
#
# Supabase'da bu odatda avtomatik to'g'ri sozlangan bo'ladi (superuser
# ulanish satrini bermaydi), lekin lokal Postgres'da buni qo'lda tekshiring.
DATABASE_URL=postgresql+asyncpg://personal_os_app:<PAROL>@<HOST>:5432/<DB_NOMI>
# Haqiqiy qiymatni generatsiya qilish uchun: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=<generatsiya-qilingan-tasodifiy-token>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Umumiy ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
