# Bu faylni .env nomiga nusxalab, haqiqiy qiymatlarni kiriting.
# .env fayli HECH QACHON GitHub'ga push qilinmaydi (.gitignore'da).

# --- Ma'lumotlar bazasi ---
# Supabase yoki lokal Postgres ulanish satri (asyncpg drayveri uchun)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personal_os

# --- JWT autentifikatsiya ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Umumiy ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
